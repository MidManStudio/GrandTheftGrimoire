<Project Sdk="Microsoft.NET.Sdk">
  <!-- Verification harness, never shipped. Compiles the core Managed sources without Unity against
       hand written UnityEngine stand-ins and runs the checks in this folder. LangVersion 9 matches
       Unity 2022.3. NPC, Crown and Favor stay out because they need the NPC native bindings, Chemistry because it needs Alembic, and Quests because it needs Questly. The NPC job has its own harness, and the Quests job is packages-test/. -->
  <PropertyGroup>
    <GtgRoot>$(MSBuildThisFileDirectory)../Assets/MidManStudio/Gtg/</GtgRoot>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0649;CS0169;CS0414;CS0067</NoWarn>
    <RootNamespace>MidManStudio.Gtg.Managed.Building.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" Exclude="RigStubs.cs" />
    <Compile Include="$(GtgRoot)Managed/**/*.cs" Exclude="$(GtgRoot)Managed/NPC/**;$(GtgRoot)Managed/Crown/**;$(GtgRoot)Managed/Favor/**;$(GtgRoot)Managed/Chemistry/**;$(GtgRoot)Managed/Quests/**" />
    <!-- Crown needs the NPC types, but these two files are plain arithmetic and the HUD heat feeder is checked through them. -->
    <Compile Include="$(GtgRoot)Managed/Crown/ManagedCrownTypes.cs;$(GtgRoot)Managed/Crown/ManagedCrownHeatMap.cs" />
    <Compile Include="$(GtgRoot)Data/ItemDatabase.cs" />
  </ItemGroup>
</Project>
