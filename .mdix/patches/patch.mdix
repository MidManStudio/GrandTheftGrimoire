    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Chemistry/Components/ChemistryComponents.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Chemistry/Components/ChemistryComponents.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Chemistry/Presentation/ChemicalHazardPresentationSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Chemistry/Presentation/ChemicalHazardPresentationSystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Chemistry/Systems/ChemicalHazardSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Chemistry/Systems/ChemicalHazardSystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Chemistry/Systems/ChemistryReactionSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Chemistry/Systems/ChemistryReactionSystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/NPC/Authoring/NPCAuthoring.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/NPC/Authoring/NPCAuthoring.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/NPC/Components/NPCComponents.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/NPC/Components/NPCComponents.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/NPC/Native/NPCManagedFallback.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/NPC/Native/NPCManagedFallback.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/NPC/Systems/NPCDecisionSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/NPC/Systems/NPCDecisionSystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")

    // Docs: location notes under each moved system's title.
    patch_insert_after("docs/GrandTheftGrimoire/character-controller.md", "# CharacterController", "\n> Code location: `Assets/MidManStudio/Gtg/ECS/CharacterController/`. The ECS sources compile only when `GTG_ECS` is defined. A MonoBehaviour version lives under `Assets/MidManStudio/Gtg/Managed/CharacterController/`, see `managed.md`.\n")
    patch_insert_after("docs/GrandTheftGrimoire/camera.md", "# Camera (`MidManStudio.Gtg.Camera`)", "\n> Code location: `Assets/MidManStudio/Gtg/ECS/Camera/`. The ECS sources compile only when `GTG_ECS` is defined. A MonoBehaviour version lives under `Assets/MidManStudio/Gtg/Managed/Camera/`, see `managed.md`.\n")
    patch_insert_after("docs/GrandTheftGrimoire/magic.md", "# Magic (`MidManStudio.Gtg.Magic`)", "\n> Code location: `Assets/MidManStudio/Gtg/ECS/Magic/`. The ECS sources compile only when `GTG_ECS` is defined. A MonoBehaviour version lives under `Assets/MidManStudio/Gtg/Managed/Magic/`, see `managed.md`.\n")
    patch_insert_after("docs/chemistry.md", "# Chemistry (`MidManStudio.Gtg.Chemistry`)", "\n> Code location: `Assets/MidManStudio/Gtg/ECS/Chemistry/`. The ECS sources compile only when `GTG_ECS` is defined. A MonoBehaviour version lives under `Assets/MidManStudio/Gtg/Managed/Chemistry/`, see `GrandTheftGrimoire/managed.md`.\n")
    patch_insert_after("docs/npc/architecture.md", "# GTG NPC architecture", "\n> Code location: `Assets/MidManStudio/Gtg/ECS/NPC/`. The ECS sources compile only when `GTG_ECS` is defined. There is no Managed NPC version yet, see `../GrandTheftGrimoire/managed.md`.\n")

    patch_insert_after("docs/GrandTheftGrimoire.md",
      "-- running notes on Editor errors and warnings, with the current analysis",
      "- [`GrandTheftGrimoire/managed.md`](GrandTheftGrimoire/managed.md)\n  -- the Managed stack: MonoBehaviour versions of the character, camera,\n  magic and chemistry systems that need no ECS package, and how the\n  `ECS/` and `Managed/` folders relate\n")

    patch_insert_after("docs/GrandTheftGrimoire.md",
      "- No asmdefs under",
      "- Two stacks: `Assets/MidManStudio/Gtg/ECS/` is wrapped in `#if GTG_ECS`,\n  `Assets/MidManStudio/Gtg/Managed/` has no ECS dependency. See\n  `GrandTheftGrimoire/managed.md`.\n")

    patch_insert_after("docs/GTG_REPO_CONVENTIONS.md",
      "## 5. ECS / DOTS and Netcode for Entities",
      "\n> Status: ECS is paused while development hardware cannot run it. The ECS code is kept under `Assets/MidManStudio/Gtg/ECS/` behind `GTG_ECS`, and the game is built in parallel on the Managed stack under `MidManStudio.Gtg.Managed.<System>`, see `GrandTheftGrimoire/managed.md`. The direction below is unchanged.\n")
)
