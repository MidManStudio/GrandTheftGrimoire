// Brought to u by MidManStudio
//
// One-shot patch: split Assets/MidManStudio/Gtg into ECS/ and Managed/.
// 1. Moves every existing system folder (and its folder .meta) under ECS/,
//    so script GUIDs and scene references survive.
// 2. Wraps every ECS-dependent C# file in #if GTG_ECS ... #endif.
// 3. Adds location notes to the existing docs.
// Run once. A dry run does not move files, so the wrap lines report
// "file not found" there; the real run resolves them after the moves.

@CONFIG(
  version    -> "1.0.0"
  author     -> "MidManStudio"
  features   -> "quickfuncs,data"
  debug_mode -> "off"
)

@QUICKFUNCS(

  ~move<object>(_src, _dst) {
    return { from_path = _src, to_path = _dst }
  }

  ~patch_insert_after<object>(_path, _anchor, _content) {
    return { path = _path, op = "insert_after", anchor = _anchor, content = _content }
  }

  ~patch_replace_regex<object>(_path, _pattern, _content) {
    return { path = _path, op = "replace_regex", pattern = _pattern, content = _content }
  }

)

@DATA(
  project_name = "GrandTheftGrimoire"

  move_files::
    move("Assets/MidManStudio/Gtg/CharacterController", "Assets/MidManStudio/Gtg/ECS/CharacterController")
    move("Assets/MidManStudio/Gtg/CharacterController.meta", "Assets/MidManStudio/Gtg/ECS/CharacterController.meta")
    move("Assets/MidManStudio/Gtg/Camera", "Assets/MidManStudio/Gtg/ECS/Camera")
    move("Assets/MidManStudio/Gtg/Camera.meta", "Assets/MidManStudio/Gtg/ECS/Camera.meta")
    move("Assets/MidManStudio/Gtg/Magic", "Assets/MidManStudio/Gtg/ECS/Magic")
    move("Assets/MidManStudio/Gtg/Magic.meta", "Assets/MidManStudio/Gtg/ECS/Magic.meta")
    move("Assets/MidManStudio/Gtg/Chemistry", "Assets/MidManStudio/Gtg/ECS/Chemistry")
    move("Assets/MidManStudio/Gtg/Chemistry.meta", "Assets/MidManStudio/Gtg/ECS/Chemistry.meta")
    move("Assets/MidManStudio/Gtg/NPC", "Assets/MidManStudio/Gtg/ECS/NPC")
    move("Assets/MidManStudio/Gtg/NPC.meta", "Assets/MidManStudio/Gtg/ECS/NPC.meta")

  patch_files::
    // Wrap the ECS-dependent sources. Both regexes refuse to match an already wrapped file.
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterAuthoring.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterAuthoring.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterComponents.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterComponents.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterGravitySystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterGravitySystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterGroundSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterGroundSystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterInputSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterInputSystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterJumpSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterJumpSystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterLookSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterLookSystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterMovementSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterMovementSystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterWalkSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/CharacterWalkSystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/PhysicsRayUtility.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/CharacterController/PhysicsRayUtility.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Camera/Presentation/CharacterCameraBridge.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Camera/Presentation/CharacterCameraBridge.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Magic/Authoring/SpellCasterAuthoring.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Magic/Authoring/SpellCasterAuthoring.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Magic/Components/SpellComponents.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Magic/Components/SpellComponents.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Magic/Presentation/FireballPresentationSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Magic/Presentation/FireballPresentationSystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Magic/Presentation/SpellVfxMaterials.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Magic/Presentation/SpellVfxMaterials.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Magic/Systems/FireballCastSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Magic/Systems/FireballCastSystem.cs", "(?<!#endif)(?<=\\S)\\n*\\Z", "\n#endif\n")
    patch_replace_regex("Assets/MidManStudio/Gtg/ECS/Magic/Systems/FireballProjectileSystem.cs", "\\A(?!#if GTG_ECS)", "#if GTG_ECS\n")
