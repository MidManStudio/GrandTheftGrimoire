<Project Sdk="Microsoft.NET.Sdk">
  <!-- CI-only harness: compiles the Unity-side native layer (no Unity needed) and runs it against the
       real gtg_npc_ffi library. Not part of the game build; Unity never sees this directory. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseAppHost>false</UseAppHost>
    <RootNamespace>MidManStudio.Gtg.NPC.AbiTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="UnityDebugStub.cs" />
    <!-- The NPC code sits under ECS/ since the Managed stack was added. These four files have no ECS dependency and
         compile in both stacks, so no GTG_ECS define is needed here. -->
    <Compile Include="../../../Assets/MidManStudio/Gtg/ECS/NPC/Native/*.cs" />
    <Compile Include="../../../Assets/MidManStudio/Gtg/ECS/NPC/Components/NPCEnums.cs" />
  </ItemGroup>
</Project>
