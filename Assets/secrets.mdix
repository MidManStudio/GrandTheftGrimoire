@CONFIG(
  version -> "1.0.0"
)

@DLM(
  DCompressor.gzip
  DEncryptor.aes256
)

@DATA(
  api_key          = "REPLACE_WITH_YOUR_KEY"
  analytics_token  = "REPLACE_WITH_TOKEN"
  cdn_url          = "https://cdn.yourgame.com"
)

@SECURITY(
  encryption -> { mode = "keyfile", algorithm = "aes256-gcm" }
)
