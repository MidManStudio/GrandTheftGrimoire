// Brought to u by MidManStudio
@CONFIG(
  version -> "1.0.0"
  features -> "data,enums"
)
@ENUMS(
  NpcRole { MERCHANT = 0, CIVILIAN = 1, GUARD = 2, ENEMY = 3, BOSS = 4 }
  DecisionBackend { STATE_MACHINE = 0, UTILITY = 1, HYBRID_ML = 2 }
  LearningMode { DISABLED = 0, FIXED_WEIGHTS = 1, ONLINE_UPDATES = 2 }
)
@DATA(
  id = "boss_prototype"
  role<enum> = NpcRole.BOSS
  decision_backend<enum> = DecisionBackend.HYBRID_ML
  can_move = true
  learning_mode<enum> = LearningMode.ONLINE_UPDATES
)
